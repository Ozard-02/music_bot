TELEGRAM_BOT_TOKEN=your_token_here
# Single user (legacy) or comma-separated allowlist for multi-user:
TELEGRAM_ALLOWED_USER_IDS=111222333,444555666
# Optional:
# QUEUE_DB_PATH=/path/to/queue.db

# HTTP API for the Laila search tab (api.py). Required to start the API;
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change_me_long_random
# API_PORT=8099
# API_BIND=0.0.0.0
# CORS for the web build (comma-separated exact origins):
# API_CORS_ORIGINS=http://localhost:8081,https://laila.example
# Telegram user id whose folder/quality API downloads use (default: first allowed id):
# API_QUEUE_USER=
# Search cache seconds (default 60) and subprocess timeout (default 20):
# SEARCH_CACHE_TTL=60
# SEARCH_TIMEOUT=20

# Optional official Spotify credentials for search (fallback: anonymous
# SpotiFLAC). Precedence: SPOTIFY_ACCESS_TOKEN > CLIENT_ID+SECRET > anonymous.
# Telegram `/spotify` writes a file that overrides these values; manage them
# there instead of restarting the container.
# SPOTIFY_CREDENTIALS_PATH=/root/.spotiflac/spotify.json
# Client credentials (recommended, no user login):
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Or a short-lived access token (for a quick test; expires):
# SPOTIFY_ACCESS_TOKEN=
# Optional market for the official search (e.g. IT, US):
# SPOTIFY_MARKET=